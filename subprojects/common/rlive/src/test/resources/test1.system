specification test1 {
    property safe: {
        var x: int

        invariant x >= 0 and x <= 10
        initial x = 0

        transition x' = 
            (if x = 0 then 1
            else if x = 1 then 2
            else if x = 2 then 3
            else if x = 3 then 4
            else if x = 4 then 5
            else if x = 5 then 3
            else x)

        transition x' =
            ( if x = 0 then 6
                    else if x = 6 then 7
                    else if x = 7 then 8
                    else if x = 8 then 9
                    else if x = 9 then 10
                    else if x = 10 then 8
                    else x)

    } models G(x /= 2 and x /= 8)
}